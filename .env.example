# Discord bot token (Developer Portal -> Bot -> Reset Token). Keep it secret!
BOT_TOKEN=
# Your own Discord user ID (Discord -> Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID)
OWNER_ID=
# Display name used in logs, status and the announcement footer
BOT_NAME=My Announcement Bot
# Optional: pause between DMs in milliseconds (minimum 1000, default 1500)
DM_DELAY_MS=1500
